# Copy this file to .env and fill in the values for the endpoint under test.

# Optional label shown in the summary table output.
S3_NAME=

# Required: base URL of the S3-compatible endpoint.
S3_ENDPOINT=http://localhost:9000

# Required: credentials for the endpoint.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional: defaults to us-east-1, which works for most self-hosted stores.
S3_REGION=us-east-1
