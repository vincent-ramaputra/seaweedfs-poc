# Default matrix: a first impression in ~12 minutes for all three variants.
# Small and large PUT/GET plus one mixed workload, at one concurrency level.
# Too short and too narrow for decisions; use matrix.full.env for those.
# Sourced by sweep.sh.

SIZES="4KiB 6MiB 16MiB"
CONCURRENCY="16"
DURATION=15s
# Warm-up excluded from analysis.
SKIP=3s
REPS=1

# Objects prepared before GET/mixed runs, capped per size by GET_MAX_BYTES.
GET_OBJECTS=200
GET_MAX_BYTES=$((512 * 1024 * 1024))

# Mixed workload: set these to the production request ratio.
MIXED_SIZE=1MiB
MIXED_CONCURRENCY="16"
MIXED_GET=45
MIXED_STAT=30
MIXED_PUT=15
MIXED_DELETE=10

LONG_MIXED_DURATION=
