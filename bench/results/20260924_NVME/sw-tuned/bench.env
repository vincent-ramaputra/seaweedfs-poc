# Tuned for an EC2 m5d.xlarge. Copy to bench/.env on that instance; see
# .env.example for the generic template and the README for what each
# setting means.
#
# Host: 4 vCPUs = 2 physical cores, hyperthreaded, 1 socket. 16 GiB RAM.
# Storage: 1x150 GB NVMe instance store (typically /dev/nvme1n1, distinct
# from the root EBS volume). The instance store is NOT mounted by default
# and does not survive a stop/start, only a reboot. Format and mount it
# before running anything, e.g.:
#
#   sudo mkfs.xfs /dev/nvme1n1
#   sudo mkdir -p /mnt/nvme1 && sudo mount /dev/nvme1n1 /mnt/nvme1
#   sudo chown "$USER" /mnt/nvme1
#
# Read the README's Caveats first: m5d.xlarge has only one physical disk, so
# the four "drives" below are directories on that one device -- the same
# single-disk caveat as a laptop. Use this setup for a ratio between the
# engines, not for absolute multi-drive numbers. For real multi-drive I/O,
# attach 4 separate EBS volumes instead and point DRIVE1-4 at their mount
# points.

# All four land on the instance-store NVMe, not the root EBS volume -- keep
# these absolute so a checkout under $HOME doesn't silently benchmark EBS.
DRIVE1=/mnt/nvme1/bench-drives/d1
DRIVE2=/mnt/nvme1/bench-drives/d2
DRIVE3=/mnt/nvme1/bench-drives/d3
DRIVE4=/mnt/nvme1/bench-drives/d4

# Set to the production MinIO release and parity (`mc admin info <alias>`).
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z-cpuv1
MINIO_PARITY=2
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

SW_IMAGE=chrislusf/seaweedfs:4.40
# 001 = 2 copies on different volume servers (same 2x overhead as 4-drive EC:2).
SW_REPLICATION=001
# All four "drives" share one 150 GB disk here, so `-max=0` sees the same
# free space for each and overestimates total volume slots -- consistent
# with the laptop caveat, not something to fix with this setting.
SW_VOLUME_SIZE_MB=1024
SW_S3_PORT=8433

# sw-tuned only (see README): physical volumes grown at once, S3 GET chunk
# cache in MB. The cache counts toward this machine's 16 GiB RAM.
SW_TUNED_GROWTH_COUNT=8
SW_TUNED_CACHE_MB=1024

WARP_IMAGE=minio/warp:v1.3.1

# CPUs both engines are pinned to: 1 of the 2 physical cores.
# CPUs warp is pinned to: the other physical core.
#
# With only 4 vCPUs total there's no room for a generous split -- the engine
# gets 2 vCPUs (one core) and so will look much slower in absolute terms
# than on production hardware; treat this as a ratio-only run, same as the
# laptop matrix.
#
# AWS Nitro instances commonly pair hyperthread siblings as N and N+numcores
# (0,2 and 1,3 here), not adjacent pairs like 0,1 and 2,3. VERIFY on the
# actual instance before running:
#   lscpu -p=CPU,CORE,SOCKET
# and adjust the two lines below if the pairing differs.
BENCH_CPUSET=0,2
WARP_CPUSET=1,3

BENCH_ACCESS_KEY=benchadmin
BENCH_SECRET_KEY=***

# Most EC2 AMIs give the default user passwordless sudo, so this should work
# as-is. If it doesn't, lib.sh prints a warning and skips it -- see
# .env.example / README for the sudoers snippet to enable it.
BENCH_DROP_CACHES=1
