# Full test matrix for the prod-like benchmark server. Sourced by sweep.sh.

SIZES="1KiB 16KiB 128KiB 1MiB 16MiB 256MiB 1GiB"
CONCURRENCY="1 8 32 128 512"
DURATION=5m
# Warm-up excluded from analysis.
SKIP=30s
REPS=3

# Objects prepared before GET/mixed runs. Capped per size by GET_MAX_BYTES so
# large sizes don't fill the drives.
GET_OBJECTS=10000
GET_MAX_BYTES=$((200 * 1024 * 1024 * 1024))

# Mixed workload: set these to the production request ratio.
MIXED_SIZE=1MiB
MIXED_CONCURRENCY="32 128"
MIXED_GET=45
MIXED_STAT=30
MIXED_PUT=15
MIXED_DELETE=10

# One long mixed run to catch latency drift and background work. Empty to skip.
LONG_MIXED_DURATION=90m
