# Copy to bench/.env. Read by both compose files and the bench scripts.

# Data drives, shared by both engines (only one engine runs at a time, and
# the drives are wiped between runs). On the benchmark server point each at a
# separate physical drive, like production. Relative paths are relative to bench/.
# On a single-disk dev machine these are just directories, so results there
# do not reflect multi-drive I/O.
DRIVE1=./drives/d1
DRIVE2=./drives/d2
DRIVE3=./drives/d3
DRIVE4=./drives/d4

# Set to the production MinIO release and parity (`mc admin info <alias>`).
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z-cpuv1
MINIO_PARITY=2
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

SW_IMAGE=chrislusf/seaweedfs:4.40
# 001 = 2 copies on different volume servers (same 2x overhead as 4-drive EC:2).
SW_REPLICATION=001
SW_VOLUME_SIZE_MB=30000
SW_S3_PORT=8433

WARP_IMAGE=minio/warp:v1.3.1

# CPUs both engines are pinned to. Keep the load generator off these cores.
BENCH_CPUSET=0-11

BENCH_ACCESS_KEY=benchadmin
BENCH_SECRET_KEY=benchadmin-secret

# Set to 0 to skip dropping the page cache between runs (needs passwordless sudo).
BENCH_DROP_CACHES=1
