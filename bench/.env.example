# Copy to bench/.env. Read by both compose files and the bench scripts.

# Data drives, shared by both engines (only one engine runs at a time, and
# the drives are wiped between runs). On the benchmark server point each at a
# separate physical drive, like production. Relative paths are relative to bench/.
# On a single-disk dev machine these are just directories, so results there
# do not reflect multi-drive I/O.
DRIVE1=./drives/d1
DRIVE2=./drives/d2
DRIVE3=./drives/d3
DRIVE4=./drives/d4

# Set to the production MinIO release and parity (`mc admin info <alias>`).
# MinIO's images moved off Docker Hub in 2025; pull from quay.io instead.
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z-cpuv1
MINIO_PARITY=2
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

SW_IMAGE=chrislusf/seaweedfs:4.40
# 001 = 2 copies on different volume servers (same 2x overhead as 4-drive EC:2).
SW_REPLICATION=001
# Writes to a volume are serialized, and each drive holds free space / volume
# size volumes, so small volumes allow more parallel writes. SeaweedFS's own
# default (30000) leaves small drives with only 1-2 volumes each.
SW_VOLUME_SIZE_MB=1024
SW_S3_PORT=8433

# sw-tuned only (see README): physical volumes grown at once, S3 GET chunk
# cache in MB.
SW_TUNED_GROWTH_COUNT=8
SW_TUNED_CACHE_MB=1024

WARP_IMAGE=minio/warp:v1.3.1

# CPUs both engines are pinned to. Keep the load generator off these cores.
BENCH_CPUSET=0-11

# CPUs warp is pinned to. Empty = unpinned, which lets warp compete with the
# engine it is measuring; a starved load generator makes both engines look
# equally slow. Must not overlap BENCH_CPUSET.
# Split by physical core, not by vCPU number: hyperthread siblings share
# execution units, so check `lscpu -p=CPU,CORE,SOCKET` before choosing a range.
WARP_CPUSET=

BENCH_ACCESS_KEY=benchadmin
BENCH_SECRET_KEY=benchadmin-secret

# Set to 0 to skip dropping the page cache between runs (needs passwordless sudo).
BENCH_DROP_CACHES=1
