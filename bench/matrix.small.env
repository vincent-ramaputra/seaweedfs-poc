# Laptop matrix: the smallest run that still produces a ratio you can defend.
# ~20 minutes per variant, ~1 hour for all three.
# Sourced by sweep.sh.
#
# Differences from matrix.env, and why:
#   - REPS=3 instead of 1, so summary.md shows a stdev. Without it you cannot
#     tell a real 1.2x from noise, which is the whole point of the run.
#   - One concurrency level instead of a curve, to pay for those reps.
#   - Object sizes kept modest: on a single-disk machine, large objects measure
#     the laptop's one NVMe partition more than they measure either engine.
#
# To cut this to ~6 minutes per variant, set REPS=1 - but then read only large
# differences, and treat anything under ~1.3x as unproven.

SIZES="4KiB 1MiB 8MiB"
CONCURRENCY="8"
DURATION=20s
# Warm-up excluded from analysis.
SKIP=5s
REPS=3

# Objects prepared before GET/mixed runs, capped per size by GET_MAX_BYTES.
# Deliberately small: with no passwordless sudo the page cache is not dropped
# between cells, so GET is served from memory at any size that fits in 22 GiB.
# A larger set would cost setup time without changing what GET measures.
GET_OBJECTS=200
GET_MAX_BYTES=$((256 * 1024 * 1024))

# warp keeps each in-flight object in memory. The largest cell here is
# 8MiB x 8 = 64 MiB, well inside this budget; sweep.sh's 16 GiB default would
# be reckless on a 22 GiB machine with ~6 GiB free.
: "${WARP_MAX_INFLIGHT_BYTES:=$((1 * 1024 * 1024 * 1024))}"

# Mixed workload: set these to the production request ratio.
MIXED_SIZE=1MiB
MIXED_CONCURRENCY="8"
MIXED_GET=45
MIXED_STAT=30
MIXED_PUT=15
MIXED_DELETE=10

# Mixed runs at a fixed total request rate (warp --rps-limit, shared by all
# clients), so it compares latency and CPU at the same load instead of maximum
# throughput. Replace with production's rate: the per-second rate of MinIO's
# `minio_s3_requests_total` metric at a busy hour. 120 is a stand-in: about
# half of MinIO's maximum mixed rate on an m5d.xlarge with gp3 (~255 req/s), so
# neither engine is saturated. Empty = unlimited, as before.
MIXED_RPS_LIMIT=120
# At a fixed rate a short run has few PUT/DELETE samples: 1m at 120 req/s gives
# ~1,000 PUTs for the p99. Empty = DURATION.
MIXED_DURATION=1m

# One long mixed run to catch latency drift and background work. Empty to skip.
LONG_MIXED_DURATION=
